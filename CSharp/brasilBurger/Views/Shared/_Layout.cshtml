<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - brasilBurger</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" integrity="" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/brasilBurger.styles.css" asp-append-version="true" />
    <link rel="shortcut icon" href="~/img/logo.png" type="image/x-icon">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Catalogue" asp-action="Index"><i class="fas fa-hamburger me-2"></i>Brasil Burger</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Catalogue" asp-action="Index">Catalogue</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link " asp-controller="Commande" asp-action="Index" asp-route-id="Context.Session.GetInt32("UserId")" >Commandes</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        @if(Context.Session.GetInt32("UserId") != null){
                            <i class="fa-solid fa-circle-user me-2" style="font-size:1.2rem;color:#FFF8EC;"></i>
                            <span class="text-white me-3">@Context.Session.GetString("UserName")</span>
                            <a asp-action="Logout" asp-controller="Auth" class="text-white text-decoration-none nav-link">Déconnexion</a>
                        }
                        else{
                            <a class="nav-link " asp-controller="Auth" asp-action="Login" >
                                <button style="width:100%" class="btn btn-orange m-3">Se connecter</button>
                            </a>
                            <a class="nav-link" asp-controller="Auth" asp-action="Register" >
                                <button style="width:100%" class="btn btn-outline-orange m-3">S'inscrire</button>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @{
                var successMessage = TempData["SuccessMessages"] as string;
                var errorMessage = TempData["ErrorMessages"] as string;
            }
            @if (Context.Session.GetInt32("UserId") != null && !string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
