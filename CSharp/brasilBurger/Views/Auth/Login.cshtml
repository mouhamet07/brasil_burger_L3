@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Connexion";
}
@model LoginVM
<div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="row w-100 shadow-lg">
        <div class="col-lg-6 auth-left d-flex flex-column justify-content-center">
            <h2>
                Bienvenue <br> chez Brasil Burger
            </h2>
        </div>
        <div class="col-lg-6 auth-right">
            <h2>Connexion</h2>
            <p>Entrez les informations de connexion</p>
            <form asp-action="Login" asp-controller="Auth" method="post">
                <div class="mb-3">
                    <label class="form-label" asp-for="Login">Login</label>
                    <input type="text" asp-for="Login" class="form-control" placeholder="Entrez votre mail ou votre téléphone">
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Password">Mot de passe</label>
                    <input type="password" asp-for="Password" class="form-control" placeholder="••••••••">
                </div>
                <button type="submit" class="btn btn-orange w-100 mb-3">Se connecter</button>
                <div class="text-center">
                    <p>
                        Vous n'avez pas de compte ?
                        <a asp-controller="Auth" asp-action="Register" class="text-decoration-none">S'inscrire</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>