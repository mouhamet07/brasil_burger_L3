{% extends 'base.html.twig' %}

{% block title %}Commandes - Brasil Burger{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Liste des commandes</h2>
        </div>
        <div class="card border-0 mb-4 shadow-sm p-3">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Rechercher une commande..." />
                            <button class="btn btn-outline" type="button">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select">
                            <option>Etat</option>
                            <option>En cours</option>
                            <option>Terminée</option>
                            <option>Annulée</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select">
                            <option>Type de commande</option>
                            <option>Burger</option>
                            <option>Menu</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="table-responsive text-center">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Client</th>
                                <th>Téléphone</th>
                                <th>Produit</th>
                                <th>Type</th>
                                <th>Etat</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>1</strong></td>
                                <td>Jean Dupont</td>
                                <td>77 123 45 67</td>
                                <td>Menu Burger</td>
                                <td>Burger</td>
                                <td><span class="badge status-pending">En cours</span></td>
                                <td>12/12/2025</td>
                                <td class="text-center action-icons">
                                    <span class="badge badge-bleu" title="Voir"><i class="fas fa-eye"></i></span>
                                    <span class="badge badge-vert" title="Terminer"><i class="fas fa-check"></i></span>
                                    <span class="badge badge-red" title="Annuler"><i class="fas fa-times"></i></span>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>2</strong></td>
                                <td>Marie Ndiaye</td>
                                <td>77 765 43 21</td>
                                <td>Burger Simple</td>
                                <td>Burger</td>
                                <td><span class="badge status-completed">Terminée</span></td>
                                <td>12/12/2025</td>
                                <td class="text-center action-icons">
                                    <span class="badge badge-bleu" title="Voir"><i class="fas fa-eye"></i></span>
                                    <span class="badge badge-vert" title="Terminer"><i class="fas fa-check"></i></span>
                                    <span class="badge badge-red" title="Annuler"><i class="fas fa-times"></i></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-center align-items-center gap-3 mt-5">
            <button class="btn btn-outline-orange">Précédent</button>
            <span>Page 1 / 5</span>
            <button class="btn btn-outline-orange">Suivant</button>
        </div>
</div>
{% endblock %}
