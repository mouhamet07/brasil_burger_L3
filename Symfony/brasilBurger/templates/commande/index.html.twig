{% extends 'base.html.twig' %}

{% block title %}Commandes - Brasil Burger{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Liste des commandes</h2>
    </div>
    <div class="card border-0 mb-4 shadow-sm p-3">
        <div class="card-body">
            {{ form_start(formSearch) }}
            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_widget(formSearch.nomClient, {'attr': {'class': 'form-control', 'placeholder': 'Rechercher un client'}}) }}
                </div>
                <div class="col-md-3">
                    {{ form_widget(formSearch.etatCmd, {'attr': {'class': 'form-select'}}) }}
                </div>
                <div class="col-md-3">
                    {{ form_widget(formSearch.typeCmd, {'attr': {'class': 'form-select'}}) }}
                </div>
            </div>
            <button type="submit" class="btn btn-orange">Filtrer</button>
            {{ form_end(formSearch) }}
        </div>
    </div>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="table-responsive text-center">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Client</th>
                            <th>Téléphone</th>
                            <th>Produit</th>
                            <th>Type</th>
                            <th>Etat</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in commandes %}
                        <tr>
                            <td><strong>{{ commande.id }}</strong></td>
                            <td>{{ commande.nomClient }}</td>
                            <td>{{ commande.telephone }}</td>
                            <td>
                                {% for item in commande.commandeItems %}
                                    {{ item.produit.value }}{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </td>
                            <td>{{ commande.type|capitalize }}</td>
                            <td>
                                {% if commande.etat == 'en_cours' %}
                                    <span class="badge status-pending">En cours</span>
                                {% elseif commande.etat == 'terminee' %}
                                    <span class="badge status-completed">Terminée</span>
                                {% elseif commande.etat == 'annulee' %}
                                    <span class="badge status-cancelled">Annulée</span>
                                {% else %}
                                    <span class="badge status-waiting">En attente</span>
                                {% endif %}
                            </td>
                            <td>{{ commande.date|date('d/m/Y H:i') }}</td>
                            <td class="text-center action-icons">
                                <a href="{{ path('app_commande_details', {'id': commande.id}) }}" class="badge badge-bleu" title="Voir"><i class="fas fa-eye"></i></a>
                                <a href="{{ path('app_commande_terminer', {'id': commande.id}) }}" class="badge badge-vert" title="Terminer"><i class="fas fa-check"></i></a>
                                <a href="{{ path('app_commande_annuler', {'id': commande.id}) }}" class="badge badge-red" title="Annuler"><i class="fas fa-times"></i></a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="8">Aucune commande trouvée</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-center align-items-center gap-3 mt-5">
        {% if pageEnCours > 1 %}
            <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all | merge({'page': pageEnCours - 1})) }}" class="btn btn-outline-orange">Précédent</a>
        {% endif %}
        <span>Page {{ pageEnCours }} / {{ nbrPage }}</span>
        {% if pageEnCours < nbrPage %}
            <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all | merge({'page': pageEnCours + 1})) }}" class="btn btn-outline-orange">Suivant</a>
        {% endif %}
    </div>
</div>
{% endblock %}
