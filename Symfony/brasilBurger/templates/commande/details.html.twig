{% extends 'base.html.twig' %}

{% block title %}Détails Commande - Brasil Burger{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">Commande #{{ commande.id }}</h3>
        <div class="action-icons">
            <a href="{{ path('app_commande_terminer', {'id': commande.id}) }}" class="btn btn-vert btn-sm"><i class="fas fa-check"></i> Terminer</a>
            <a href="{{ path('app_commande_annuler', {'id': commande.id}) }}" class="btn btn-red btn-sm"><i class="fas fa-times"></i> Annuler</a>
        </div>
    </div>
    <div class="card mb-3 shadow-sm p-3">
        <ul class="list-group list-group-flush">
            {% for item in commande.commandeItems %}
                <li class="list-group-item d-flex justify-content-between">
                    {{ item.produit.nom }}
                    <span>{{ (item.prixUnitaire * item.quantite)|number_format(0, ' ', ' ') }} FCFA</span>
                </li>
            {% endfor %}
            {% if commande.zone is not null %}
                <li class="list-group-item d-flex justify-content-between">
                    Livraison {{ commande.zone.nom }}
                    <span>{{ commande.zone.prixLivraison|number_format(0, ' ', ' ') }} FCFA</span>
                </li>
            {% endif %}
        </ul>
    </div>
    <div class="card mb-3 shadow-sm p-3">
        <p><strong>Client :</strong> {{ commande.client.nomComplet }}</p>
        <p><strong>Téléphone :</strong> {{ commande.client.telephone }}</p>
        <p><strong>Type :</strong> {{ commande.type.value|capitalize }}</p>
        <p><strong>Zone :</strong> {{ commande.zone.nom ?? '—' }}</p>
        <p><strong>Statut :</strong>
            {% if commande.etat.value == 'EN_COURS' %}
                <span class="badge status-pending">En cours</span>
            {% elseif commande.etat.value == 'TERMINEE' %}
                <span class="badge status-completed">Terminée</span>
            {% elseif commande.etat.value == 'ANNULEE' %}
                <span class="badge status-cancelled">Annulée</span>
            {% else %}
                <span class="badge status-waiting">En attente</span>
            {% endif %}
        </p>
        <p><strong>Date :</strong> {{ commande.dateCommande|date('d/m/Y H:i') }}</p>
    </div>
    <div class="card p-3 shadow-sm">
        <h5 class="fw-bold mb-0">
            Total : {{ commande.montantTotal|number_format(0, ' ', ' ') }} FCFA
        </h5>
    </div>
</div>
{% endblock %}
